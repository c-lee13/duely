# Copy to .env, and keep .env.local identical for every variable you set in both.
# Who reads what:
#   Next.js           .env.local overrides .env
#   Foundry (forge)   .env only, via the contracts/.env -> ../.env symlink; it never reads .env.local
#   npm run chain:*   node --env-file=.env, so .env only
#   other scripts/*   .env.local first, then .env
# Define each variable once per file and use literal values: `$VAR` expansion is not supported by every loader.

# ==========================================
# Supabase
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DATA_MODE=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Gemini
# ==========================================
GEMINI_API_KEY=
GEMINI_EVALUATION_MODEL=
DUELY_EVALUATOR_MODE=

# ==========================================
# OpenAI
# ==========================================
OPENAI_API_KEY=

# ==========================================
# XRPL EVM Testnet
# ==========================================
NEXT_PUBLIC_XRPL_EVM_RPC_URL=https://rpc.testnet.xrplevm.org
NEXT_PUBLIC_XRPL_EVM_CHAIN_ID=1449000

# ==========================================
# Active Contract Deployment
# Options: dusd | rlusd
# Default: dusd
# ==========================================
# Values: dusd | rlusd (V1, operator reserve) | v2 (DuelyVault + InvoiceAdvanceV2, RLUSD). Both variables must agree.
# v2 enables the vault page, claims and vault-funded advances; the evaluator key must then be the V2 evaluator.
DUELY_DEPLOYMENT=rlusd
NEXT_PUBLIC_DUELY_DEPLOYMENT=rlusd

# Public contract addresses
# RLUSD deployment:
# InvoiceAdvance: 0x1B972ec6B1B5E0b592010e7484beF0accC382792
# RLUSD token:    0x27b57a9D0b8d24EB97259c4E2279e45255e016f3

# dUSD deployment:
# InvoiceAdvance: 0x328fc0DbF3d1F704B065192f4bFC7583bfA550E0
# MockUSDC token: 0x5ff7b6ae08c37868303e7A815308Af476421506c

NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=

# ==========================================
# Contract Deployment
# ==========================================
DEPLOYER_PRIVATE_KEY=
XRPL_EVM_RPC_URL=https://rpc.testnet.xrplevm.org
CHAIN_ID=1449000
DEPLOYER_ADDRESS=
ADMIN_ADDRESS=
OPERATOR_ADDRESS=
EVALUATOR_ADDRESS=

# ==========================================
# Track A Integration / Smoke Tests
# ==========================================
# Set these to the same deployment selected above.

# dUSD fallback:
# TOKEN_ADDRESS=0x5ff7b6ae08c37868303e7A815308Af476421506c
# CONTRACT_ADDRESS=0x328fc0DbF3d1F704B065192f4bFC7583bfA550E0

# RLUSD:
# TOKEN_ADDRESS=0x27b57a9D0b8d24EB97259c4E2279e45255e016f3
# CONTRACT_ADDRESS=0x1B972ec6B1B5E0b592010e7484beF0accC382792

TOKEN_ADDRESS=
CONTRACT_ADDRESS=

FREELANCER_ADDRESS=
CLIENT_ADDRESS=

# Evidence upload funding gate. Set to "true" once the chain adapter exists (Phase 3) so evidence is accepted only
# when funding was confirmed on-chain, never from the cached database status.
EVIDENCE_REQUIRE_CHAIN_VERIFICATION=

# Private keys — local testing only
# Never expose these through NEXT_PUBLIC_* variables.
# EVALUATOR_PRIVATE_KEY is read ONLY by the server-side advance signer (Phase 3) for the testnet demo; it must stay in
# .env / a secret store, never in NEXT_PUBLIC_*, logs or git.
CLIENT_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
EVALUATOR_PRIVATE_KEY=

# ==========================================
# V2 (pooled LP vault): additive; the V1 variables above are not changed.
# Same addresses, two consumers: Foundry (script/DeployV2.s.sol) reads VAULT_ADDRESS and ESCROW_ADDRESS;
# Next.js / the app read NEXT_PUBLIC_V2_*. Source of truth: contracts/deployments/xrpl-evm-testnet-v2.json.
# Public addresses only (safe for the browser). The V2 evaluator reuses EVALUATOR_PRIVATE_KEY above (server only).
# The pauser is the operator (fixed in DeployV2.s.sol; there is no PAUSER_ADDRESS variable).
# ==========================================
VAULT_ADDRESS=0x5f8B53B32acab32F8c283CB40a4B7ac04792B6E8
ESCROW_ADDRESS=0x2E1598D6DBDa061EB6CafCa5D7AEe1630A04Ba96

NEXT_PUBLIC_V2_VAULT_ADDRESS=0x5f8B53B32acab32F8c283CB40a4B7ac04792B6E8
NEXT_PUBLIC_V2_ESCROW_ADDRESS=0x2E1598D6DBDa061EB6CafCa5D7AEe1630A04Ba96
NEXT_PUBLIC_V2_TOKEN_ADDRESS=0x27b57a9D0b8d24EB97259c4E2279e45255e016f3
NEXT_PUBLIC_V2_DEPLOY_BLOCK=9234793
