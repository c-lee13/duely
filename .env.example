NEXT_PUBLIC_DUELY_DEPLOYMENT=rlusd

# Public contract addresses
# RLUSD deployment:
# InvoiceAdvance: 0x1B972ec6B1B5E0b592010e7484beF0accC382792
# RLUSD token:    0x27b57a9D0b8d24EB97259c4E2279e45255e016f3

# dUSD deployment:
# InvoiceAdvance: 0x328fc0DbF3d1F704B065192f4bFC7583bfA550E0
# MockUSDC token: 0x5ff7b6ae08c37868303e7A815308Af476421506c

NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=

# ==========================================
# Contract Deployment
# ==========================================
DEPLOYER_PRIVATE_KEY=
XRPL_EVM_RPC_URL=https://rpc.testnet.xrplevm.org
DEPLOYER_ADDRESS=
ADMIN_ADDRESS=
OPERATOR_ADDRESS=
