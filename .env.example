# Data adapter. mock (default): the in-browser demo, stored in localStorage, never touches Supabase.
# api: LIVE data through the authenticated API routes and Supabase (needs the keys below and migrations 1-8).
NEXT_PUBLIC_DATA_MODE=mock

# Supabase — copy this file to .env.local (git-ignored) and fill in from
# Project Settings -> API. Never commit real values.
# Only NEXT_PUBLIC_* values reach the browser; the service-role key is SERVER-ONLY.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead (also accepted).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin of this deployment, e.g. https://duely.example (no trailing slash). Used for the
# wallet sign-in domain and cross-origin checks. Defaults to the request origin when empty.
NEXT_PUBLIC_SITE_URL=

# Evidence uploads: set to true to refuse evidence unless the invoice's funding was confirmed on-chain
# by a chain adapter (server-only). Leave false until the chain adapter exists.
EVIDENCE_REQUIRE_CHAIN_VERIFICATION=false

# Development-only evaluator (server-only). "demo" enables a deterministic, clearly simulated evaluator outside
# production; any other value (or production) leaves /api/evaluate disabled. Demo results can never authorize a payment.
DUELY_EVALUATOR_MODE=

# OpenAI
OPENAI_API_KEY=

# XRPL EVM
NEXT_PUBLIC_XRPL_EVM_RPC_URL=
NEXT_PUBLIC_XRPL_EVM_CHAIN_ID=
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=

# Contract deployment
DEPLOYER_PRIVATE_KEY=
