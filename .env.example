# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Payment token / deployment: dusd (default, live-tested mock) or rlusd (deployed, not yet live-tested)
DUELY_DEPLOYMENT=dusd
NEXT_PUBLIC_DUELY_DEPLOYMENT=dusd

# XRPL EVM
NEXT_PUBLIC_XRPL_EVM_RPC_URL=https://rpc.testnet.xrplevm.org
NEXT_PUBLIC_XRPL_EVM_CHAIN_ID=1449000
NEXT_PUBLIC_CONTRACT_ADDRESS=0x328fc0DbF3d1F704B065192f4bFC7583bfA550E0
NEXT_PUBLIC_TOKEN_ADDRESS=0x5ff7b6ae08c37868303e7A815308Af476421506c

# Deploying against an existing token (RLUSD) instead of a new MockUSDC: set all three, otherwise leave empty
PAYMENT_TOKEN_ADDRESS=
PAYMENT_TOKEN_DECIMALS=
PAYMENT_TOKEN_SYMBOL=

# Contract deployment: unused. Sign with Foundry keystores (--account duely-deployer); never store raw keys.
DEPLOYER_PRIVATE_KEY=
# Track A deployment (copy to contracts/.env for forge; never commit real values)
# XRPL EVM testnet per docs.xrplevm.org: RPC https://rpc.testnet.xrplevm.org, chain ID 1449000,
# explorer https://explorer.testnet.xrplevm.org, native currency XRP
# Authenticated provider URL (QuickNode) - SECRET, server-side/Foundry only, never NEXT_PUBLIC_ and never committed
XRPL_EVM_RPC_URL=
CHAIN_ID=1449000
DEPLOYER_ADDRESS=
ADMIN_ADDRESS=
OPERATOR_ADDRESS=
EVALUATOR_ADDRESS=

# Track A smoke test (contracts/script/smoke.sh) - signs with Foundry keystores, no raw keys.
# Passwords are prompted (hidden) or read from the optional *_PASSWORD_FILE paths; never put passwords here.
CLIENT_ADDRESS=
FREELANCER_ADDRESS=
TOKEN_ADDRESS=0x5ff7b6ae08c37868303e7A815308Af476421506c
CONTRACT_ADDRESS=0x328fc0DbF3d1F704B065192f4bFC7583bfA550E0
DEPLOYER_ACCOUNT=duely-deployer
CLIENT_ACCOUNT=duely-client
EVALUATOR_ACCOUNT=duely-evaluator
